backend/.claude/
backend/.cursor/
backend/.devin/
backend/.agents/

# Local tool settings, specific to one machine.
.claude/settings.local.json

# Noise
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
